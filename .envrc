#!/usr/bin/env bash
# Source this from the worktree root:  source .envrc
_self="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Worktree-scoped: override defaults from PyTorchSimFrontend/extension_config.py
export TORCHSIM_DIR="$_self"
export TORCHSIM_DUMP_PATH="$_self/outputs"
export TORCHSIM_LOG_PATH="$_self/togsim_results"

# Resolve both the frontend and the built torch_openreg from THIS worktree --
# develop-npu carries the .so, so this shell never falls back to the editable
# install that points at /workspace/PyTorchSim.
export PYTHONPATH="$_self/PyTorchSimDevice:$_self:${PYTHONPATH:-}"

# Container-dedicated shared binaries.
export GEM5_PATH="/gem5/release/gem5.opt"
export TORCHSIM_LLVM_PATH="/riscv-llvm/bin"
export RISCV="/workspace/riscv"

export PS1="[torchsim:$(basename "$_self")] ${PS1:-\\w\\$ }"

# This worktree drives its own triton-npu checkout, pinned (rule 15 / rule 13a).
export TNPU_DIR=/workspace/wt-bert

# Values first: spike judges, gem5/TOGSim add nothing to that judgement (rule 13a).
# This YAML also sets pytorchsim_functional_verify_per_kernel, so a bring-up run
# stops at the first divergent kernel and names it.
export TOGSIM_CONFIG=/workspace/tpuv3-notiming.yml

# triton_shared develop (8921c48) -- has the general reduce lowering and the
# gather/wrap fixes. The stock /workspace/triton-src build does NOT.
export TNPU_TRITON_SHARED_OPT=/workspace/ts-develop-build/third_party/triton_shared/tools/triton-shared-opt/triton-shared-opt

# Our backend, not the MLIR route (read at device registration).
export TORCHSIM_TRITON_CODEGEN=1

unset _self
echo "Activated worktree: $TORCHSIM_DIR  (TNPU_DIR=$TNPU_DIR)"
