# CPU-only base. PyTorchSim never executes CUDA: the npu PrivateUse1 backend
# (third_party/openreg) simulates CUDA behavior on the CPU and forces math-only
# SDPA, so no GPU libraries are needed at build or run time. We stay on
# ubuntu:22.04 (matching the prebuilt gem5/llvm/spike release ABIs: libpython3.11,
# libprotobuf.so.23) and install the CPU PyTorch wheels.
ARG PYTORCH_IMAGE=ubuntu:22.04
FROM ${PYTORCH_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# System dependencies (gem5 / TOGSim build + runtime) and Python 3.11 (deadsnakes).
# Copied/adapted from the Gem5 Docker file.
RUN apt-get -y update && \
    apt-get -y install software-properties-common ca-certificates gnupg && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get -y update && \
    apt-get -y install build-essential git m4 zlib1g zlib1g-dev \
    libprotobuf-dev protobuf-compiler libprotoc-dev libgoogle-perftools-dev \
    libboost-all-dev libhdf5-serial-dev libpng-dev libelf-dev pkg-config \
    libssl-dev libasan6 libubsan1 curl wget device-tree-compiler ninja-build \
    python3.11 python3.11-dev python3.11-venv python3.11-distutils && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 && \
    rm -rf /var/lib/apt/lists/*

# CPU PyTorch (no CUDA wheels). torchvision is required by the vision model tests.
# torch 2.10 is pinned for the Triton codegen route: it is the first release whose
# Inductor targets triton 3.6, which is the version triton-npu is built against
# (triton 3.6 pins LLVM 23, and both sides of triton-npu's textual IR seam must be
# the same LLVM). On 2.8 the frontend had to be shimmed onto a triton it did not
# expect; on 2.10 the versions simply agree.
RUN python3.11 -m pip install --no-cache-dir \
    torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu

# Triton, for the Inductor Triton codegen route (PyTorchSimFrontend/triton_backend).
# Inductor imports triton while GENERATING a kernel, so it is needed even though
# nothing here compiles or launches through triton's own runtime -- triton-npu
# compiles the kernel ahead of time to a RISC-V ELF using its own triton build.
# Not a dependency of the CPU torch wheels, hence installed explicitly.
RUN python3.11 -m pip install --no-cache-dir triton==3.6.0

# TorchSim Python dependencies.
#
# transformers is pinned exactly rather than by upper bound: the model code the
# tests build against ships inside it, so a float here changes what the suite
# means. THE PIN IS 5.15.0 AND IT IS THE ONLY VERSION THIS TREE TARGETS.
#
# THE TEST TREE IS NOT FINISHED CATCHING UP, and this pin is deliberately ahead
# of it. Measured on 5.15.0 at the time of the switch:
#   tests/models/Qwen/test_qwen.py  the `2-moe` preset -- one of the two in its
#                                   gate -- raises AttributeError before it
#                                   reaches the backend: 5.x moved `top_k` and
#                                   `norm_topk_prob` off the MoE block and onto
#                                   the config, and _assert_character still
#                                   reads them off the block. `tiny`, `3-8b`,
#                                   `2.5-7b` and `3-0.6b` build clean.
# That is model-side work, tracked separately from this pin.
#
# WHAT IT BUYS: 16 qwen modules against 4.51.3's 7 -- qwen2_5_omni, qwen3_next,
# qwen3_vl, qwen3_vl_moe, qwen3_omni_moe, qwen3_5, qwen3_5_moe and qwen3_asr.
#
# WHAT IT COSTS, and both are carried deliberately rather than unnoticed:
#   * huggingface-hub 1.x, and httpx and typer behind it. 4.57.6 needs none of
#     them, which is the whole dependency argument for the last 4.x.
#   * CLIP, and DeepSeek-V3's grouped_mm gate kernel. Both are named in the
#     block below with what each would take to fix.
#
# numpy is NO LONGER held below 2. That bound was here for transformers and
# diffusers, and neither asks for it any more: transformers 5.15.0 wants
# numpy>=1.17 and diffusers 0.34.0 does not constrain it. It is pinned exactly
# instead, at the version the suite was verified against -- onnx, matplotlib,
# scikit-learn, pandas, seaborn, cv2 and ultralytics all import clean on 2.4.6
# with torch 2.10, which is what a floating numpy would stop guaranteeing.
#
# 5.15.0 IS BEING EVALUATED ON THIS BRANCH, and what it buys is Qwen: 16 qwen
# modules against 7, adding qwen2_5_omni, qwen3_next, qwen3_vl, qwen3_vl_moe,
# qwen3_omni_moe, qwen3_asr and the qwen3_5 pair. What it costs, measured
# against this image rather than guessed:
#
#   huggingface-hub  0.36.2 -> >=1.5.0,<2.0    a MAJOR jump, and the one to
#                                              watch: it is what pulls httpx
#   httpx, typer     absent -> required        new dependencies
#   tokenizers       0.21.4 -> >=0.22.0        minor
#   safetensors, regex, numpy                  already satisfied
#
# No installed package requires transformers, so nothing is capped from below;
# diffusers 0.34.0 asks for it only in its test and dev extras and its UNet
# builds and runs under 5.15.0 (measured).
#
# WHAT BREAKS AT 5.15.0, from running all 18 model tests on the Triton route
# against an isolated 5.15.0 rather than from reading the changelog. 14 pass --
# BERT, GPT-2, both Llama files plus test_llama.py, Mistral, MobileNet, YOLOv5,
# SwinV2, ConvNeXtV2, ResNet, ViT, Transformer and SD1.5, the last at its usual
# 18 minutes. Four fail, and they are four different kinds of thing:
#
#   tests/models/Qwen/test_qwen.py       OURS. A MoE block's experts are a
#       fused `Qwen2MoeExperts` module now, not a ModuleList, so the character
#       assert's `len(block.experts)` raises. One line, and it can be written
#       to hold on both versions.
#
#   tests/models/Qwen/test_qwen_vl.py    OURS, and more than a line. The VL
#       configs are restructured: `Qwen2VLConfig.hidden_size` is gone (it lives
#       under text_config) and `rope_scaling` is `rope_parameters`.
#
#   tests/models/DeepSeek/...            NOT OURS AND NOT FIXABLE HERE. The
#       Hub's remote modeling file imports `is_torch_fx_available` from
#       transformers.utils.import_utils, which v5 removed. That file is pinned
#       4.x code. The way out is transformers' OWN deepseek_v3, which exists
#       from 4.51 -- i.e. stop using trust_remote_code for this model.
#
#   tests/models/test_clip.py            THE BACKEND, and the same at 4.57.6.
#       Stage 6 refuses it by name: "llc spilled a vector register GROUP to the
#       stack", with 2 x <32 x i64> live at the peak, 17 of 32 registers. Spike
#       would die at stage 7 with an invalid spad address, so the refusal is
#       correct and the work is real.
#
#       IT NEEDS TWO FIXES, NOT ONE, and that is why it is not done here.
#       Measured on that kernel's spec directly, walking the reduction block:
#
#           R0_BLOCK 512, 256   the spill above
#           R0_BLOCK 128        a DIFFERENT refusal -- 'vector.load' op most
#                               minor memref dim must have unit stride, on a
#                               memref<128xf32, strided<[128]>> that a
#                               memref.subview took as a COLUMN of a
#                               [128, 128] tile
#           R0_BLOCK 64         compiles
#
#       So a spill-triggered shrink (the answer the spad overflow already gets)
#       walks into the second one on its way down. The second is a missing
#       contiguity test where the vector loop is marked (bank_vectorize) and
#       sized (fit_to_hardware) -- a strided access wants a gather or a scalar
#       loop. A minimal coverage kernel for it was attempted twice and BOTH
#       PASSED, so it is not pinned yet; the reproduction is the CLIP kernel
#       spec at R0_BLOCK 128.
#
# SWITCHED. The pin below is 5.15.0, taken with CLIP and DeepSeek-V3 as known
# regressions rather than waiting for the suite to be green -- both are named
# above with the backend work each needs. 4.57.6 remains the cheaper target on
# dependencies and is what to fall back to if hub 1.x proves expensive; it is
# NOT what this tree runs.
# nanobind builds the torchsim dialect's Python extension (pytorchsim-triton-opt's
# dialect/, which the codegen route loads to register `torchsim.*` ops). The range is
# MLIR's own (mlir/python/requirements.txt) -- the extension is compiled against the
# same bindings, so a 3.x here would not be the nanobind those bindings expect.
RUN python3.11 -m pip install --no-cache-dir "nanobind>=2.9,<3.0"

RUN python3.11 -m pip install --no-cache-dir \
    numpy==2.4.6 onnx matplotlib scikit-learn pydot tabulate \
    transformers==5.15.0 diffusers==0.34.0 \
    conan==1.56.0 cmake==3.26.4 && \
    python3.11 -m pip install --no-cache-dir --no-deps ultralytics && \
    python3.11 -m pip install --no-cache-dir opencv-python-headless pandas seaborn \
    psutil pyyaml requests tqdm py-cpuinfo

# Download RISC-V tool chain (elf toolchain is the one used to build riscv-pk).
RUN wget -q https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2023.12.14/riscv64-elf-ubuntu-20.04-llvm-nightly-2023.12.14-nightly.tar.gz && \
    tar -zxf riscv64-elf-ubuntu-20.04-llvm-nightly-2023.12.14-nightly.tar.gz && \
    rm riscv64-elf-ubuntu-20.04-llvm-nightly-2023.12.14-nightly.tar.gz

ENV RISCV=/workspace/riscv
ENV PATH=$RISCV/bin:$PATH

ARG GEM5_ASSET_ID
ARG SPIKE_ASSET_ID
ENV PATH=$PATH:/root/.local/bin
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

# Download GEM5 for torchsim
RUN curl -L -H "Accept: application/octet-stream" https://api.github.com/repos/PSAL-POSTECH/gem5/releases/assets/${GEM5_ASSET_ID} -o /tmp/gem5-release.tar.gz && \
    mkdir -p /gem5 && \
    tar -xzf /tmp/gem5-release.tar.gz -C /gem5 && \
    rm /tmp/gem5-release.tar.gz
ENV GEM5_PATH=/gem5/release/gem5.opt

# No LLVM: tog moved to the compiler and nothing here imports mlir.
ENV TORCHSIM_DIR=/workspace/PyTorchSim

# Download Spike simulator
RUN curl -L -H "Accept: application/octet-stream" https://api.github.com/repos/PSAL-POSTECH/riscv-isa-sim/releases/assets/${SPIKE_ASSET_ID} -o /tmp/spike-release.tar.gz && \
    tar -xzf /tmp/spike-release.tar.gz -C / && rm /tmp/spike-release.tar.gz

# Store SPIKE for TorchSim
ENV PATH="/release/bin:${PATH}"
ENV LD_LIBRARY_PATH="/release/lib:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="/release/include:${C_INCLUDE_PATH}"

# Install Proxy kernel
RUN git clone https://github.com/riscv-software-src/riscv-pk.git && \
     cd riscv-pk && git checkout 4f3debe4d04f56d31089c1c716a27e2d5245e9a1 && mkdir build && cd build && \
    ../configure --prefix=$RISCV --host=riscv64-unknown-elf && make -j && make install
