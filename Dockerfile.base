# syntax=docker/dockerfile:1.7
# CI's base image: the compiler's own published image at the pinned commit, plus PyTorch and what
# the tests import. The compiler image (PSAL-POSTECH/PyTorchSim-Triton-Backend, workflow images.yml,
# one tag per commit) already carries Ubuntu 22.04 with python3.11, the vcix-accelerator environment
# (RISC-V toolchain, pk, Spike, gem5), LLVM, Triton built with the torchsim backend, the accelerator
# model, the compiler, its dialect and extension, and TOGSim at the PyTorchSim it pins. Nothing of
# that is built here. Rebuilt when scripts/ci/thirdparty_base_pin.sh changes, i.e. when this file,
# the compiler pin or thirdparty/github-releases.json moves.
ARG PTB_IMAGE=ghcr.io/psal-postech/pytorchsim-triton-backend:main
FROM ${PTB_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# `python` beside the image's python3 (3.11); boost headers for TOGSim's cmake probe.
RUN apt-get -y update && \
    apt-get -y install --no-install-recommends libboost-all-dev && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    rm -rf /var/lib/apt/lists/*

# PyTorchSim is CPU-only: the npu PrivateUse1 backend simulates the device on the CPU.
RUN python3.11 -m pip install --no-cache-dir \
    torch==2.14.0 torchvision==0.29.0 --index-url https://download.pytorch.org/whl/cpu

# Triton is the image's source build (/workspace/triton-src, on PYTHONPATH below), with the
# torchsim backend linked in; a pip triton would shadow nothing but confuse `import triton`.
RUN python3.11 -m pip install --no-cache-dir \
    numpy==2.4.6 onnx matplotlib scikit-learn pydot tabulate \
    transformers==5.15.0 diffusers==0.34.0 \
    conan==1.56.0 cmake==3.26.4 && \
    python3.11 -m pip install --no-cache-dir --no-deps ultralytics && \
    python3.11 -m pip install --no-cache-dir opencv-python-headless pandas seaborn \
    psutil pyyaml requests tqdm py-cpuinfo

# The compiler route's environment, as the compiler's setup/env.sh spells it for a local install
# (TORCHSIM_PREFIX=/workspace in the image). VCIX_ENV_ROOT comes from the environment image.
ENV TORCHSIM_PREFIX=/workspace \
    TORCHSIM_COMPILE_DIR=/workspace/pytorchsim-triton-compiler \
    TORCHSIM_COMPILE_TARGET=/workspace/pytorchsim-triton-compiler/tests/targets/tpuv6e.json \
    TORCHSIM_COMPILE_TRITON_SRC=/workspace/triton-src/python \
    TRITON_BACKENDS_IN_TREE=1 \
    TRITON_PLUGIN_PATHS=/workspace/torchsim-triton-ext-build/libtorchsim_triton_ext.so \
    PYTHONPATH=/workspace/triton-src/python \
    GEM5_PATH=${VCIX_ENV_ROOT}/gem5/build/RISCV/gem5.opt \
    PATH=/workspace/pytorchsim-triton-compiler:${VCIX_ENV_ROOT}/riscv/bin:/root/.local/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH} \
    TORCHSIM_DIR=/workspace/PyTorchSim

RUN python3 /workspace/pytorchsim-triton-compiler/pytorchsim-triton-compiler doctor
